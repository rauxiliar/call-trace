# Copy to .env and fill in. .env is gitignored.
# Local VoIPmonitor GUI user (not Azure AD).
VOIPMONITOR_URL=https://voipmon.broadvoice.com
VOIPMONITOR_USER=your-voipmonitor-user
VOIPMONITOR_PASSWORD=your-voipmonitor-password
# Cloudflare Zero Trust service token for voipmon.broadvoice.com.
CF_ACCESS_CLIENT_ID=your-cloudflare-access-client-id
CF_ACCESS_CLIENT_SECRET=your-cloudflare-access-client-secret

# Optional. Default is config/clouds.yaml (gitignored).
# CLOUDS_CONFIG=config/clouds.yaml
